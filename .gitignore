# Downloaded third-party repositories and source archives are tracked by manifest.
preparation/external/
preparation/raw/

# Generated benchmark manifests can be reproduced from preparation scripts.
benchmark/generated/

# Large model/feature artifacts.
artifacts/
data/
# Keep reproducible experiment metadata and logs in Git, but never checkpoints or
# prediction arrays.  The two-level rules avoid accidentally adding arbitrary
# generated files when a trainer gains a new output.
outputs/*
!outputs/*/
outputs/*/*
!outputs/*/config.json
!outputs/*/environment.json
!outputs/*/history.json
!outputs/*/output.log
!outputs/*/validation_metrics.json
!outputs/*/value_metrics.json
!outputs/*/edge_metrics.json
!outputs/*/ranking_metrics.json
!outputs/*/regret_metrics.json
!outputs/*/query_budget.json
!outputs/*/queried_nodes.json
!outputs/*/oracle_manifest.json
!outputs/*/optimization_rollouts.json
!outputs/*/aggregate_metrics.json
!outputs/*/tensorboard/
outputs/*/tensorboard/*
!outputs/*/tensorboard/events.out.tfevents.*
!outputs/validation_selection/*.json
outputs/**/checkpoints/
outputs/**/*predictions*.npz
outputs/**/descriptor_stats.npz
*.pt
*.pth
*.pkl

__pycache__/
*.py[cod]
.pytest_cache/
